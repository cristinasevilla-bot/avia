<script type="application/x-avia-lazy">
  // nav background on scroll
  const nav = document.getElementById('nav');
  const updateNav = () => nav && nav.classList.toggle('scrolled', scrollY > 30);
  updateNav();
  addEventListener('scroll', updateNav, {passive:true});

  // compact mobile navigation
  const menuToggle = document.getElementById('menuToggle');
  const mobileMenu = document.getElementById('mobileMenu');
  if (nav && menuToggle && mobileMenu) {
    const setMenu = open => {
      nav.classList.toggle('menu-open', open);
      menuToggle.setAttribute('aria-expanded', String(open));
      menuToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };
    menuToggle.addEventListener('click', () => setMenu(!nav.classList.contains('menu-open')));
    mobileMenu.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setMenu(false)));
    document.addEventListener('click', e => { if (!nav.contains(e.target)) setMenu(false); });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') setMenu(false); });
  }

  // The scene is visually separated from the copy with a canvas mask. Keeping
  // the old collision rectangle active made nearby objects bounce and tremble.
  window.__avoidRect = null;

  // 3D mark in the hero (works in both modes; SVG stays as fallback)
  const heroStage = document.getElementById('heroStage');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hasMotionStack = !reduced && Boolean(window.gsap && window.ScrollTrigger);

  // Claim the headline before the browser paints its CSS entrance animation.
  // Without this, CSS starts the reveal and GSAP resets it a moment later,
  // producing the visible jump/flicker at the top of the page.
  if (hasMotionStack) document.documentElement.classList.add('gsap-on');

  if (!hasMotionStack) {
    // ---------- fallback: CSS reveal on scroll ----------
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(entries => {
        entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('on'); io.unobserve(e.target); } });
      }, {threshold:.15, rootMargin:'0px 0px -40px 0px'});
      document.querySelectorAll('.rv').forEach(el => io.observe(el));
    } else {
      document.querySelectorAll('.rv').forEach(el => el.classList.add('on'));
    }
  } else {
    // ---------- full motion stack ----------
    gsap.registerPlugin(ScrollTrigger);

    // smooth inertial scroll
    if (window.Lenis) {
      const lenis = new Lenis({duration:1.15, smoothWheel:true});
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add(t => lenis.raf(t * 1000));
      gsap.ticker.lagSmoothing(0);
    }

    // scroll progress bar
    gsap.to('.progress i', {scaleX:1, ease:'none', scrollTrigger:{start:0, end:'max', scrub:.3}});

    // split hero headline into characters (em.grad-text stays one unit)
    document.querySelectorAll('.hero h1 .line > span').forEach(line => {
      [...line.childNodes].forEach(node => {
        if (node.nodeType === 3) {
          const frag = document.createDocumentFragment();
          node.textContent.split(' ').forEach((word, wi, arr) => {
            if (word) {
              const w = document.createElement('span');
              w.className = 'word';
              [...word].forEach(c => {
                const i = document.createElement('i');
                i.className = 'ch';
                i.style.fontStyle = 'inherit';
                i.textContent = c;
                w.appendChild(i);
              });
              frag.appendChild(w);
            }
            if (wi < arr.length - 1) frag.appendChild(document.createTextNode(' '));
          });
          line.replaceChild(frag, node);
        } else if (node.classList) {
          node.classList.add('ch');
        }
      });
    });
    gsap.from('.hero h1 .ch', {yPercent:130, rotate:5, stagger:.028, duration:1.1, ease:'power4.out', delay:.15});

    // hero parallax on scroll-out
    const heroScrub = () => ({trigger:'.hero', start:'top top', end:'bottom top', scrub:true});
    gsap.to('.blob.b1', {y:150, scrollTrigger:heroScrub()});
    gsap.to('.blob.b2', {y:-100, scrollTrigger:heroScrub()});
    gsap.to('.hero-center', {y:90, opacity:.3, scrollTrigger:heroScrub()});
    gsap.to('.hero-stage', {y:55, scrollTrigger:heroScrub()});
    gsap.to('.orbit-chip', {y:-70, scrollTrigger:heroScrub()});

    // statement: words light up as you scroll
    const st = document.getElementById('statement');
    if (st) {
      const wrapWords = node => {
        [...node.childNodes].forEach(n => {
          if (n.nodeType === 3) {
            const frag = document.createDocumentFragment();
            n.textContent.split(/(\s+)/).forEach(tok => {
              if (!tok) return;
              if (/^\s+$/.test(tok)) frag.appendChild(document.createTextNode(tok));
              else { const sp = document.createElement('span'); sp.className = 'iw'; sp.textContent = tok; frag.appendChild(sp); }
            });
            node.replaceChild(frag, n);
          } else if (n.nodeType === 1) wrapWords(n);
        });
      };
      wrapWords(st);
      gsap.to(st.querySelectorAll('.iw'), {opacity:1, stagger:.05, ease:'none',
        scrollTrigger:{trigger:st, start:'top 82%', end:'bottom 48%', scrub:.4}});
    }

    // section reveals with perspective depth
    gsap.set('.rv', {opacity:0, y:48, rotationX:7, transformPerspective:800, transformOrigin:'50% 100%'});
    ScrollTrigger.batch('.rv', {
      start:'top 88%',
      onEnter: b => gsap.to(b, {opacity:1, y:0, rotationX:0, duration:1.05, ease:'power3.out', stagger:.09, overwrite:true})
    });

    // process line draws with scroll
    gsap.to('.track-line i', {scaleX:1, ease:'none',
      scrollTrigger:{trigger:'#process .steps', start:'top 85%', end:'bottom 55%', scrub:.4}});

    // pinned horizontal protocol scene (desktop)
    if (innerWidth > 900) {
      const stepsEl = document.querySelector('#process .steps');
      const procWrap = document.querySelector('#process .wrap');
      if (stepsEl && procWrap) {
        stepsEl.classList.add('pinned');
        const dist = stepsEl.scrollWidth - procWrap.clientWidth;
        if (dist > 40) {
          gsap.to(stepsEl, {x:-dist, ease:'none',
            scrollTrigger:{trigger:'#process', start:'top top', end:() => '+=' + (stepsEl.scrollWidth - procWrap.clientWidth + 300), pin:true, scrub:.5,
              invalidateOnRefresh:true}});
        } else {
          stepsEl.classList.remove('pinned');
        }
      }
    }

    // service card icons drift on scroll (parallax between rows)
    gsap.utils.toArray('.svc').forEach((card, i) => {
      gsap.fromTo(card, {y: i % 3 * 14}, {y: -(i % 3) * 14, ease:'none',
        scrollTrigger:{trigger:'.svc-grid', start:'top bottom', end:'bottom top', scrub:true}});
    });

    if (matchMedia('(pointer:fine)').matches) {
      // 3D tilt on cards
      document.querySelectorAll('.svc, .step, .ai-card').forEach(el => {
        const rx = gsap.quickTo(el, 'rotationX', {duration:.5, ease:'power3'});
        const ry = gsap.quickTo(el, 'rotationY', {duration:.5, ease:'power3'});
        gsap.set(el, {transformPerspective:900});
        el.addEventListener('mousemove', e => {
          const r = el.getBoundingClientRect();
          ry(((e.clientX - r.left) / r.width - .5) * 10);
          rx(-((e.clientY - r.top) / r.height - .5) * 8);
        });
        el.addEventListener('mouseleave', () => { rx(0); ry(0); });
      });

      // magnetic buttons
      document.querySelectorAll('.btn').forEach(b => {
        b.addEventListener('mousemove', e => {
          const r = b.getBoundingClientRect();
          gsap.to(b, {x:(e.clientX - r.left - r.width/2)*.25, y:(e.clientY - r.top - r.height/2)*.35, duration:.4, ease:'power3.out'});
        });
        b.addEventListener('mouseleave', () => gsap.to(b, {x:0, y:0, duration:.6, ease:'elastic.out(1,.45)'}));
      });
      // gradient glow follows the cursor
      const dot = document.querySelector('.cursor-dot');
      let cx = innerWidth/2, cy = innerHeight/2, tx = cx, ty = cy;
      addEventListener('mousemove', e => {tx = e.clientX; ty = e.clientY});
      gsap.ticker.add(() => {
        cx += (tx - cx) * .12; cy += (ty - cy) * .12;
        dot.style.transform = `translate(${cx}px,${cy}px)`;
      });
    }
  }

  // WebGL setup is comparatively expensive. Start it after the DOM motion
  // stack is stable so it cannot interrupt or restart the hero entrance.
  if (heroStage && window.initMark3D) {
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        if (window.initMark3D(heroStage)) heroStage.classList.add('has3d');
      });
    });
  }

  // live vitals readout in the hero card
  const bpmEl = document.getElementById('bpmRead');
  if (bpmEl) setInterval(() => {
    bpmEl.textContent = (64 + Math.floor(Math.random() * 12)) + ' bpm · signal stable';
  }, 1600);

  // sound toggle on Eva's video
  const sndBtn = document.getElementById('sndBtn');
  if (sndBtn) sndBtn.addEventListener('click', () => {
    const v = document.getElementById('evaVideo');
    v.muted = !v.muted;
    if (!v.muted) { v.currentTime = 0; v.play().catch(() => {}); }
    sndBtn.querySelectorAll('.snd-off').forEach(el => el.style.display = v.muted ? '' : 'none');
    sndBtn.querySelector('.snd-on').style.display = v.muted ? 'none' : '';
    sndBtn.setAttribute('aria-label', v.muted ? 'Unmute Eva' : 'Mute Eva');
  });

  // Videos: fetch and play only when they approach the viewport.
  document.querySelectorAll('video[autoplay]').forEach(v => {
    const observer = new IntersectionObserver(entries => entries.forEach(entry => {
      if (entry.isIntersecting) {
        if (!v.src && v.dataset.src) {
          v.src = v.dataset.src;
          v.load();
        }
        v.play().catch(() => {});
      } else {
        v.pause();
      }
    }), {threshold:.15, rootMargin:'1200px 0px'});
    observer.observe(v);
  });

  // FAQ accordion (both modes)
  document.querySelectorAll('.faq-q').forEach((q, i) => {
    const item = q.closest('.faq-item');
    const answer = item && item.querySelector('.faq-a');
    if (!item || !answer) return;
    if (!answer.id) answer.id = 'faq-answer-' + (i + 1);
    q.setAttribute('aria-controls', answer.id);
    q.setAttribute('aria-expanded', String(item.classList.contains('open')));
    q.addEventListener('click', () => {
      item.classList.toggle('open');
      q.setAttribute('aria-expanded', String(item.classList.contains('open')));
    });
  });

  // phone demo: Eva books a patient at 2:47am (plays when scrolled into view)
  (() => {
    const box = document.getElementById('phoneMsgs');
    if (!box) return;
    const SEQ = [
      ['user', 'Hi, do you treat melasma?'],
      ['bot', 'We do, with medical-grade peels and laser. Would you like a consultation with Dr Shah?'],
      ['user', 'Yes please. Any time Thursday?'],
      ['bot', 'Thursday 3:40pm is free. Shall I book you in?'],
      ['user', 'Perfect.'],
      ['bot', 'Booked. Confirmation on its way by WhatsApp. Sleep well.']
    ];
    const mk = (cls, text) => {
      const d = document.createElement('div');
      d.className = 'msg ' + cls;
      d.textContent = text;
      box.appendChild(d);
    };
    function play(i) {
      if (i >= SEQ.length) { setTimeout(() => { box.innerHTML = ''; play(0); }, 4500); return; }
      const [who, text] = SEQ[i];
      if (who === 'bot') {
        const t = document.createElement('div');
        t.className = 'typing'; t.innerHTML = '<i></i><i></i><i></i>';
        box.appendChild(t);
        setTimeout(() => { t.remove(); mk('bot', text); play(i + 1); }, 1200);
      } else {
        mk('user', text);
        setTimeout(() => play(i + 1), 1000);
      }
    }
    let started = false;
    new IntersectionObserver((e, o) => {
      if (e[0].isIntersecting && !started) { started = true; play(0); o.disconnect(); }
    }, {threshold:.35}).observe(box);
  })();

  // numbered brief -> pre-filled email
  const briefForm = document.getElementById('brief');
  if (briefForm) briefForm.addEventListener('submit', e => {
    e.preventDefault();
    const v = id => document.getElementById(id).value.trim();
    const body = encodeURIComponent(
      'Name: ' + v('bfName') + '\nClinic: ' + v('bfClinic') + '\nEmail: ' + v('bfEmail') + '\nGoal: ' + v('bfBrief'));
    location.href = 'mailto:hello@avia.agency?subject=' +
      encodeURIComponent('Strategy call — ' + (v('bfClinic') || v('bfName'))) + '&body=' + body;
  });

  // ---------- Eva chat widget ----------
  (() => {
    const panel = document.getElementById('chatPanel'),
          fab = document.getElementById('chatFab'),
          teaser = document.getElementById('chatTeaser'),
          msgs = document.getElementById('chatMsgs'),
          chipsBox = document.getElementById('chatChips'),
          input = document.getElementById('chatText'),
          send = document.getElementById('chatSend');
    const close = document.getElementById('chatClose');
    if (!panel || !fab || !teaser || !msgs || !chipsBox || !input || !send || !close) return;
    let opened = false, greeted = false;
    let returnFocus = null;

    const CHIPS = [
      ['What can Eva do?', "I answer treatment questions, triage enquiries and book consultations straight into the clinic diary, 24/7. Every conversation ends in a booking, a lead captured, or a polite goodbye, never a missed patient."],
      ['How do avatar clones work?', "We film your lead clinician for around ten minutes. From that, we create their digital twin, which then presents treatment explainers, social clips and aftercare videos on demand, no reshoots."],
      ['Book a demo', "Happy to. This widget is the demo, on your live site I'd be trained on your treatments and connected to your diary. Email hello@avia.agency and the team will set up a full walkthrough."]
    ];

    const KEYWORDS = [
      [/price|cost|fee|how much/i, "Pricing depends on which services you combine, campaigns, the AI concierge, avatar videos. The team scopes it on a free strategy call: hello@avia.agency."],
      [/book|demo|call|appointment/i, "Let's do it. Email hello@avia.agency and the team will set up a walkthrough with your clinic's own data."],
      [/avatar|clone|video/i, "One ten-minute filming session with your clinician, and their digital twin can present unlimited videos, explainers, socials, aftercare, in their own voice."],
      [/bot|ai|chat|concierge|assistant/i, "I'm an example of the AI concierge AVIA builds for clinics, trained on your treatments, connected to your diary, always on."],
      [/hi|hello|hey/i, "Hello! Ask me about AVIA's services, the avatar clones, or what I can do for a clinic's bookings."]
    ];
    const FALLBACK = "Good question. On a live deployment I'd be trained on your clinic's treatments and policies. For now, try one of the suggestions below, or email hello@avia.agency.";

    const scrollDown = () => { msgs.scrollTop = msgs.scrollHeight; };
    const addMsg = (text, who) => {
      const d = document.createElement('div');
      d.className = 'msg ' + who;
      d.textContent = text;
      msgs.appendChild(d);
      scrollDown();
    };
    const botReply = (text, delay = 900) => {
      const t = document.createElement('div');
      t.className = 'typing';
      t.innerHTML = '<i></i><i></i><i></i>';
      msgs.appendChild(t);
      scrollDown();
      setTimeout(() => { t.remove(); addMsg(text, 'bot'); }, delay);
    };
    const renderChips = () => {
      chipsBox.innerHTML = '';
      CHIPS.forEach(([q, a]) => {
        const b = document.createElement('button');
        b.className = 'chip';
        b.type = 'button';
        b.textContent = q;
        b.onclick = () => { addMsg(q, 'user'); botReply(a, 1100); };
        chipsBox.appendChild(b);
      });
    };
    const respond = raw => {
      const hit = KEYWORDS.find(([re]) => re.test(raw));
      botReply(hit ? hit[1] : FALLBACK, 1100);
    };
    const submit = () => {
      const v = input.value.trim();
      if (!v) return;
      input.value = '';
      addMsg(v, 'user');
      respond(v);
    };

    const openChat = () => {
      returnFocus = document.activeElement;
      opened = true;
      teaser.classList.remove('show');
      panel.classList.add('open');
      panel.setAttribute('aria-modal', 'true');
      panel.setAttribute('aria-hidden', 'false');
      fab.setAttribute('aria-expanded', 'true');
      setTimeout(() => input.focus(), 0);
      if (!greeted) {
        greeted = true;
        botReply("Hi, I'm Eva, AVIA's AI patient concierge.", 900);
        setTimeout(() => botReply("Ask me anything, or try one of these:", 900), 2100);
        setTimeout(renderChips, 3200);
      }
    };
    const closeChat = () => {
      panel.classList.remove('open');
      panel.setAttribute('aria-hidden', 'true');
      fab.setAttribute('aria-expanded', 'false');
      if (returnFocus && returnFocus.focus) returnFocus.focus();
    };
    fab.setAttribute('aria-controls', 'chatPanel');
    fab.setAttribute('aria-expanded', 'false');
    panel.setAttribute('aria-hidden', 'true');
    fab.addEventListener('click', () => panel.classList.contains('open') ? closeChat() : openChat());
    close.addEventListener('click', closeChat);
    const cta1 = document.getElementById('openChatCta');
    if (cta1) cta1.addEventListener('click', openChat);
    const cta2 = document.getElementById('openChatCta2');
    if (cta2) cta2.addEventListener('click', openChat);
    teaser.addEventListener('click', openChat);
    send.addEventListener('click', submit);
    input.addEventListener('keydown', e => { if (e.key === 'Enter') submit(); });
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && panel.classList.contains('open')) closeChat();
    });
    setTimeout(() => { if (!opened) teaser.classList.add('show'); }, 3500);
    setTimeout(() => { if (!opened) teaser.classList.remove('show'); }, 14000);
  })();
</script>
<script>
  // Paint the complete HTML/CSS page first, then initialize animations and
  // interactions during the browser's next idle period.
  (() => {
    const start = () => requestAnimationFrame(() => requestAnimationFrame(() => {
      const run = () => {
        document.documentElement.classList.remove('js-pending');
        document.querySelectorAll('script[type="application/x-avia-lazy"]').forEach(block => {
          const script = document.createElement('script');
          script.textContent = block.textContent;
          document.head.appendChild(script);
          script.remove();
        });
      };

      // Mobile browsers often postpone idle work while painting or scrolling.
      // Start the lighter mobile setup immediately; keep idle scheduling only
      // for larger screens where the full scene has more work to do.
      if (matchMedia('(max-width: 900px)').matches) run();
      else if ('requestIdleCallback' in window) requestIdleCallback(run, {timeout:700});
      else setTimeout(run, 30);
    }));

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start, {once:true});
    } else {
      start();
    }
  })();
</script>
