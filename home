
<!DOCTYPE html>
<html lang="en" class="js-pending">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AVIA — Medical + Wellness Marketing</title>
<meta name="description" content="AVIA is a specialist marketing agency for clinics, medical aesthetics and wellness brands. Patient acquisition, brand and growth for regulated healthcare.">
<link rel="icon" href="https://assets.cdn.filesafe.space/F0YJCJcv3pzVw2DOpa5P/media/6a94452f7fb05fdeb8fccdcf.jpg" type="image/jpeg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#101a2e;
    --ink-soft:#3c4a63;
    --muted:#6b7890;
    --bg:#fbfcfe;
    --surface:#ffffff;
    --line:rgba(16,26,46,.08);
    --blue:#176c9e;
    --violet:#16856f;
    --magenta:#1b9678;
    --grad:linear-gradient(100deg,#176c9e 0%,#16856f 62%,#1b9678 100%);
    --radius:20px;
    --serif:'Cormorant Garamond',Georgia,serif;
    --sans:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{
    font-family:var(--sans);
    background:var(--bg);
    color:var(--ink);
    line-height:1.6;
    overflow-x:hidden;
    -webkit-font-smoothing:antialiased;
  }
  ::selection{background:rgba(22,133,111,.18)}

  /* ---------- utilities ---------- */
  .wrap{max-width:1180px;margin:0 auto;padding:0 28px}
  .eyebrow{
    display:inline-flex;align-items:center;gap:10px;
    font-size:11px;font-weight:600;letter-spacing:.28em;text-transform:uppercase;
    color:var(--violet);margin-bottom:18px;
  }
  .eyebrow::before{
    content:"/";font-size:14px;font-weight:700;
    background:var(--grad);-webkit-background-clip:text;background-clip:text;
    -webkit-text-fill-color:transparent;color:transparent;
  }
  h1,h2,.serif{font-family:var(--serif);font-weight:500;line-height:1.08;letter-spacing:.01em}
  h2{font-size:clamp(34px,4.6vw,54px);color:var(--ink)}
  .grad-text{
    background:var(--grad);
    -webkit-background-clip:text;background-clip:text;
    -webkit-text-fill-color:transparent;color:transparent;
  }
  .section{padding:110px 0}
  .section-head{max-width:640px;margin-bottom:64px}
  .section-head p{margin-top:18px;color:var(--muted);font-size:17px}

  /* ---------- reveal animations ---------- */
  .rv{opacity:0;transform:translateY(34px);transition:opacity .9s cubic-bezier(.2,.65,.25,1),transform .9s cubic-bezier(.2,.65,.25,1)}
  .rv.on{opacity:1;transform:none}
  .js-pending .rv{opacity:1;transform:none;transition:none}
  .js-pending .hero h1 .line span{animation:none;transform:none}
  .js-pending .hero-kicker,.js-pending .hero-cta{animation:none;opacity:1;transform:none}
  .rv-d1{transition-delay:.08s}.rv-d2{transition-delay:.16s}.rv-d3{transition-delay:.24s}
  .rv-d4{transition-delay:.32s}.rv-d5{transition-delay:.4s}
  @media (prefers-reduced-motion:reduce){
    .rv{opacity:1;transform:none;transition:none}
    *{animation-duration:.01ms!important;animation-iteration-count:1!important}
    html{scroll-behavior:auto}
  }

  /* ---------- nav ---------- */
  nav{
    position:fixed;top:14px;left:0;right:0;z-index:50;
    transition:transform .35s ease;
  }
  .nav-in{
    display:flex;align-items:center;justify-content:space-between;height:64px;
    padding:0 10px 0 18px;border:1px solid rgba(255,255,255,.72);border-radius:22px;
    background:rgba(251,252,254,.72);backdrop-filter:blur(18px) saturate(145%);
    -webkit-backdrop-filter:blur(18px) saturate(145%);
    box-shadow:0 12px 40px -24px rgba(16,26,46,.38),inset 0 1px 0 rgba(255,255,255,.75);
    transition:background .35s,box-shadow .35s,border-color .35s;
  }
  nav.scrolled .nav-in{background:rgba(251,252,254,.92);border-color:rgba(16,26,46,.08);box-shadow:0 18px 48px -24px rgba(16,26,46,.48)}
  .logo{display:flex;align-items:center;gap:12px;text-decoration:none}
  .logo img{width:40px;height:40px;object-fit:cover;border-radius:10px;mix-blend-mode:multiply}
  .wordmark{
    font-family:var(--serif);font-size:27px;letter-spacing:.34em;color:var(--ink);
    font-weight:500;transform:translateY(1px);
  }
  .nav-links{display:flex;gap:6px;align-items:center}
  .nav-links a{
    text-decoration:none;color:var(--ink-soft);font-size:13px;font-weight:600;
    position:relative;padding:10px 13px;border-radius:13px;transition:color .25s,background .25s,transform .25s;
  }
  .nav-links a:not(.btn):hover{color:var(--ink);background:rgba(23,108,158,.07);transform:translateY(-1px)}
  .btn{
    display:inline-flex;align-items:center;gap:10px;
    background:linear-gradient(135deg,#101a2e,#1b2e46);color:#fff!important;border-radius:999px;
    padding:8px 9px 8px 22px;font-size:14px;font-weight:600;text-decoration:none;border:1px solid rgba(255,255,255,.1);
    transition:transform .3s cubic-bezier(.2,.65,.25,1),box-shadow .3s;
    position:relative;overflow:hidden;isolation:isolate;
  }
  .btn::before{
    content:"";position:absolute;inset:0;background:var(--grad);
    opacity:0;transition:opacity .35s;z-index:-1;
  }
  .btn:hover{transform:translateY(-2px);box-shadow:0 12px 30px -10px rgba(22,133,111,.5)}
  .btn:hover::before{opacity:1}
  .btn .arr{width:34px;height:34px;border-radius:50%;display:inline-grid;place-items:center;background:rgba(255,255,255,.14);transition:transform .3s,background .3s}
  .btn:hover .arr{transform:translateX(2px) rotate(-8deg);background:rgba(255,255,255,.24)}
  .btn.ghost{background:rgba(255,255,255,.5);color:var(--ink)!important;border:1px solid rgba(16,26,46,.14)}
  .btn.ghost:hover{color:#fff!important;border-color:transparent}
  .nav-links .btn{margin-left:5px;padding:6px 7px 6px 18px}
  .nav-links .btn .arr{width:32px;height:32px}
  .menu-toggle{display:none;width:44px;height:44px;border:0;border-radius:14px;background:var(--ink);cursor:pointer;padding:0;position:relative}
  .menu-toggle i,.menu-toggle::before,.menu-toggle::after{content:"";position:absolute;left:13px;width:18px;height:1.5px;border-radius:2px;background:#fff;transition:transform .3s,top .3s,opacity .2s}
  .menu-toggle::before{top:15px}.menu-toggle i{top:21px}.menu-toggle::after{top:27px}
  .menu-toggle[aria-expanded="true"]::before{top:21px;transform:rotate(45deg)}
  .menu-toggle[aria-expanded="true"] i{opacity:0}
  .menu-toggle[aria-expanded="true"]::after{top:21px;transform:rotate(-45deg)}
  .mobile-menu{display:none}
  @media(max-width:840px){
    nav{top:10px}.nav-in{height:58px;padding-left:12px;border-radius:19px}.wordmark{font-size:23px}.logo img{width:36px;height:36px}
    .nav-links{display:none}.menu-toggle{display:block}
    .mobile-menu{display:grid;position:absolute;top:68px;left:28px;right:28px;padding:10px;border:1px solid rgba(255,255,255,.75);border-radius:20px;background:rgba(251,252,254,.96);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);box-shadow:0 24px 60px -24px rgba(16,26,46,.5);opacity:0;transform:translateY(-10px) scale(.98);transform-origin:top;pointer-events:none;transition:opacity .25s,transform .3s cubic-bezier(.2,.7,.2,1)}
    nav.menu-open .mobile-menu{opacity:1;transform:none;pointer-events:auto}
    .mobile-menu a{display:flex;align-items:center;justify-content:space-between;padding:13px 14px;border-radius:12px;color:var(--ink);font-size:15px;font-weight:600;text-decoration:none}
    .mobile-menu a::after{content:"↗";color:var(--violet);font-weight:400}
    .mobile-menu a:hover{background:rgba(23,108,158,.07)}
    .mobile-menu .mobile-cta{margin-top:5px;background:var(--grad);color:#fff}
    .mobile-menu .mobile-cta::after{color:#fff}
  }

  /* ---------- hero ---------- */
  header.hero{
    position:relative;min-height:100svh;display:flex;flex-direction:column;
    justify-content:center;padding:150px 0 90px;overflow:hidden;
  }
  .blob{position:absolute;border-radius:50%;filter:blur(100px);opacity:.36;pointer-events:none}
  .blob.b1{width:560px;height:560px;background:#a9c3d3;top:-160px;right:-120px;animation:drift1 16s ease-in-out infinite}
  .blob.b2{width:480px;height:480px;background:#b2cfc5;bottom:-180px;left:-140px;animation:drift2 19s ease-in-out infinite}
  .blob.b3{width:320px;height:320px;background:#c2d5cf;top:30%;left:55%;opacity:.24;animation:drift1 22s ease-in-out infinite reverse}
  @keyframes drift1{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(-60px,50px) scale(1.12)}}
  @keyframes drift2{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(70px,-45px) scale(1.08)}}
  .hero-grid{
    position:absolute;inset:0;pointer-events:none;opacity:.5;
    background-image:linear-gradient(rgba(16,26,46,.035) 1px,transparent 1px),
                     linear-gradient(90deg,rgba(16,26,46,.035) 1px,transparent 1px);
    background-size:64px 64px;
    mask-image:radial-gradient(ellipse 75% 65% at 50% 40%,#000 30%,transparent 75%);
    -webkit-mask-image:radial-gradient(ellipse 75% 65% at 50% 40%,#000 30%,transparent 75%);
  }
  .hero-stage{position:absolute;inset:0;z-index:1;pointer-events:none}
  .hero-stage canvas{
    display:block;width:100%;height:100%;opacity:0;transition:opacity .45s ease;
    transform:translateX(7%);
    mask-image:linear-gradient(90deg,transparent 0%,transparent 48%,rgba(0,0,0,.2) 57%,#000 68%);
    -webkit-mask-image:linear-gradient(90deg,transparent 0%,transparent 48%,rgba(0,0,0,.2) 57%,#000 68%);
  }
  .fallback-mark{position:absolute;left:76%;top:55%;transform:translate(-50%,-50%);width:min(430px,41vw);border-radius:28px;mix-blend-mode:multiply;opacity:.68;transition:opacity .35s ease,visibility 0s linear .35s;animation:markFallbackFloat 5.5s ease-in-out infinite}
  @keyframes markFallbackFloat{
    0%,100%{transform:translate(-50%,-50%) rotate(-1deg)}
    50%{transform:translate(-50%,calc(-50% - 14px)) rotate(1deg)}
  }
  .hero-stage.has3d canvas{opacity:1}
  .hero-stage.has3d .fallback-mark{opacity:0;visibility:hidden}
  .mobile-charms{display:none}
  .hero-center{position:relative;z-index:2;width:100%;text-align:left;display:flex;flex-direction:column;align-items:flex-start}
  .hero-center::before{
    content:"";position:absolute;left:28%;top:46%;transform:translate(-50%,-50%);z-index:-1;
    width:96%;height:380px;pointer-events:none;
    background:radial-gradient(ellipse at center,rgba(240,243,250,.85) 0%,rgba(240,243,250,.45) 45%,transparent 72%);
  }
  .floor-fade{
    position:absolute;left:0;right:0;bottom:0;height:24vh;z-index:1;pointer-events:none;
    background:linear-gradient(180deg,transparent,rgba(238,241,250,.55) 55%,rgba(238,241,250,.92));
  }
  @media(max-width:860px){
    header.hero{min-height:max(100svh,760px);justify-content:flex-start;padding:118px 0 64px}
    .hero-center{align-items:center;text-align:center}
    .hero-center::before{left:50%;top:42%;width:125%;height:330px}
    .hero-stage canvas{
      transform:translateY(20%) scale(.94);transform-origin:50% 62%;opacity:.78!important;
      mask-image:linear-gradient(180deg,transparent 0%,transparent 41%,rgba(0,0,0,.35) 53%,#000 67%);
      -webkit-mask-image:linear-gradient(180deg,transparent 0%,transparent 41%,rgba(0,0,0,.35) 53%,#000 67%);
    }
    .fallback-mark{left:50%;top:72%;width:min(300px,60vw);opacity:.48;animation-duration:4.5s}
    .hero-stage.has3d .fallback-mark{opacity:0}
    .mobile-charms{display:block;position:absolute;left:50%;top:72%;width:min(390px,92vw);aspect-ratio:1;transform:translate(-50%,-50%);z-index:2}
    .mobile-charms i{position:absolute;display:block;background:linear-gradient(145deg,var(--blue),var(--violet));box-shadow:inset 2px 2px 5px rgba(255,255,255,.5),0 12px 25px -12px rgba(16,26,46,.5);will-change:transform}
    .mobile-charms .orb{border-radius:50%}
    .mobile-charms .pill{border-radius:999px}
    .mobile-charms .c1{width:34px;height:34px;left:7%;top:28%;animation:charmA 5.2s ease-in-out infinite}
    .mobile-charms .c2{width:25px;height:25px;right:8%;top:21%;animation:charmB 4.4s ease-in-out infinite .4s}
    .mobile-charms .c3{width:27px;height:58px;left:16%;bottom:14%;transform:rotate(-28deg);animation:charmC 5.8s ease-in-out infinite .7s}
    .mobile-charms .c4{width:50px;height:23px;right:5%;bottom:24%;transform:rotate(18deg);animation:charmD 4.8s ease-in-out infinite .2s}
    .mobile-charms .c5{width:18px;height:18px;right:22%;top:6%;background:linear-gradient(145deg,#fff,var(--violet));animation:charmA 4.1s ease-in-out infinite .9s}
    .mobile-charms .c6{width:42px;height:18px;left:3%;top:55%;transform:rotate(12deg);animation:charmD 5.5s ease-in-out infinite 1.1s}
    @keyframes charmA{0%,100%{transform:translate(0,0) rotate(0)}50%{transform:translate(8px,-15px) rotate(18deg)}}
    @keyframes charmB{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(-12px,11px) scale(1.16)}}
    @keyframes charmC{0%,100%{transform:translate(0,0) rotate(-28deg)}50%{transform:translate(10px,-13px) rotate(-12deg)}}
    @keyframes charmD{0%,100%{transform:translate(0,0) rotate(18deg)}50%{transform:translate(-9px,-12px) rotate(2deg)}}
  }
  @media(max-width:520px){
    header.hero{min-height:max(100svh,720px);padding-top:108px}
    .wrap{padding-left:20px;padding-right:20px}
    .hero h1 .line{padding-left:0;padding-right:0}
    .hero-stage canvas{transform:translateY(22%) scale(.9);opacity:.82!important}
  }
  .hero-kicker{font-size:12px;font-weight:600;letter-spacing:.3em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:28px;opacity:0;animation:fadeUp .8s ease .15s forwards}
  .hero h1{color:var(--ink);line-height:1.04;max-width:min(900px,64vw)}
  @media(max-width:860px){.hero h1{max-width:none}}
  .hero h1 .line{display:block;overflow:hidden;padding:.04em .12em}
  .hero h1 .line span{display:inline-block;transform:translateY(112%);animation:riseUp 1.1s cubic-bezier(.2,.65,.2,1) forwards}
  .hero h1 .line:nth-child(2) span{animation-delay:.14s}
  @keyframes riseUp{to{transform:translateY(0)}}
  @keyframes fadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}
  .t-serif{font-family:var(--serif);font-style:italic;font-weight:500;font-size:clamp(34px,4.3vw,68px);letter-spacing:.01em}
  .t-sans{font-family:var(--sans);font-weight:700;letter-spacing:-.035em;font-size:clamp(42px,5.6vw,84px)}
  .t-serif .ch{font-style:italic}
  .hero-cta{margin-top:46px;opacity:0;animation:fadeUp 1s ease .85s forwards}
  @keyframes floaty{0%,100%{transform:translateY(0) rotate(-.4deg)}50%{transform:translateY(-16px) rotate(.5deg)}}
  @keyframes chipIn{from{opacity:0;transform:translateY(16px)}}
  .orbit-chip{
    position:absolute;z-index:2;background:#fff;border:1px solid var(--line);border-radius:14px;
    padding:10px 16px;font-size:12.5px;font-weight:600;color:var(--ink-soft);
    box-shadow:0 14px 30px -14px rgba(46,68,120,.35);
    display:flex;align-items:center;gap:8px;white-space:nowrap;
  }
  .orbit-chip .dot{width:7px;height:7px;border-radius:50%;background:var(--grad)}
  .chip1{top:17%;right:13%;left:auto;animation:chipIn .7s ease 1.5s backwards,floaty 6s ease-in-out infinite .6s}
  .chip2{top:56%;right:3.5%;animation:chipIn .7s ease 1.8s backwards,floaty 8s ease-in-out infinite 1.1s}
  .chip3{bottom:17%;right:19%;left:auto;animation:chipIn .7s ease 2.1s backwards,floaty 7s ease-in-out infinite .2s}
  .vitals-free{position:absolute;top:10%;right:5%;z-index:2;display:flex;align-items:center;gap:8px;animation:chipIn .7s ease 2.4s backwards,floaty 9s ease-in-out infinite .9s}
  .vitals-free .rec{width:7px;height:7px;border-radius:50%;background:#ff5470;animation:blinkRec 1.4s steps(2) infinite}
  .ecg{position:absolute;left:0;right:0;bottom:88px;z-index:2;opacity:.55;pointer-events:none}
  .ecg svg{width:100%;height:46px;display:block}
  .ecg path{stroke:#16856f;stroke-width:1.5;fill:none;opacity:.8;stroke-dasharray:900 260;animation:ecgMove 9s linear infinite}
  @keyframes ecgMove{to{stroke-dashoffset:-1160}}
  .intro{padding:140px 0 90px}
  .statement{
    font-family:var(--serif);font-weight:500;font-size:clamp(26px,3.4vw,46px);line-height:1.35;
    color:var(--ink);max-width:1020px;margin:0 auto;text-align:center;letter-spacing:.01em;
  }
  .statement em{font-style:italic;background:var(--grad);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .gsap-on .statement .iw{opacity:.13}
  .trust-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:36px;max-width:1020px;margin:74px auto 0}
  @media(max-width:760px){.trust-grid{grid-template-columns:1fr;gap:24px}}
  .tp{border-top:1px solid rgba(16,26,46,.15);padding-top:20px;text-align:left;transition:transform .4s cubic-bezier(.2,.65,.25,1)}
  .tp:hover{transform:translateY(-4px)}
  .tp .mono{display:block;margin-bottom:12px}
  .tp b{display:block;font-size:17px;font-weight:600;color:var(--ink);margin-bottom:5px}
  .tp > span:last-child{font-size:14px;color:var(--muted)}
  @media(max-width:860px){.orbit-chip,.vitals-free,.ecg{display:none}}
  @media(max-width:860px){.hero-cta{margin-top:34px}}
  @media(max-width:520px){
    .hero-kicker{font-size:10px;letter-spacing:.24em;margin-bottom:20px}
    .t-serif{font-size:clamp(32px,10.5vw,46px)}
    .t-sans{font-size:clamp(38px,12vw,54px)}
  }
  .scroll-hint{
    position:absolute;bottom:26px;left:50%;transform:translateX(-50%);
    font-size:10.5px;letter-spacing:.3em;text-transform:uppercase;color:var(--muted);
    display:flex;flex-direction:column;align-items:center;gap:10px;
    opacity:0;animation:fadeUp 1s ease 1.4s forwards;
  }
  .scroll-hint::after{
    content:"";width:1px;height:38px;background:linear-gradient(var(--muted),transparent);
    animation:pulseLine 1.8s ease-in-out infinite;
  }
  @keyframes pulseLine{0%,100%{opacity:.25}50%{opacity:1}}
  @media(max-width:860px){.scroll-hint{bottom:16px}}

  /* ---------- marquee ---------- */
  .marquee-band{border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:26px 0;background:var(--surface);overflow:hidden}
  .marquee-label{text-align:center;font-size:11px;letter-spacing:.28em;text-transform:uppercase;color:var(--muted);margin-bottom:18px}
  .marquee{display:flex;overflow:hidden;user-select:none;mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);-webkit-mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent)}
  .marquee-track{display:flex;gap:70px;padding-right:70px;flex-shrink:0;align-items:center;animation:scrollX 30s linear infinite}
  .marquee:hover .marquee-track{animation-play-state:paused}
  @keyframes scrollX{to{transform:translateX(-100%)}}
  .m-item{font-family:var(--serif);font-size:21px;letter-spacing:.12em;color:#9aa6bb;white-space:nowrap;display:flex;align-items:center;gap:70px}
  .m-item::after{content:"✦";font-size:11px;color:#c9d2e0}
  .marquee.rev{margin-top:16px}
  .marquee.rev .marquee-track{animation-direction:reverse;animation-duration:36s}
  .marquee.rev .m-item{font-family:var(--sans);font-size:12px;font-weight:600;letter-spacing:.24em;text-transform:uppercase;color:#b3bccc}
  .marquee.rev .m-item::after{content:"·";font-size:16px}

  /* ---------- services ---------- */
  .svc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
  @media(max-width:960px){.svc-grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:640px){.svc-grid{grid-template-columns:1fr}}
  .svc{
    position:relative;background:var(--surface);border:1px solid var(--line);
    border-radius:var(--radius);padding:34px 30px;overflow:hidden;
    transition:transform .45s cubic-bezier(.2,.65,.25,1),box-shadow .45s,border-color .45s;
  }
  .svc:hover{transform:translateY(-8px);box-shadow:0 30px 60px -30px rgba(46,68,120,.3);border-color:rgba(22,133,111,.3)}
  .svc::before{
    content:"";position:absolute;top:0;left:0;right:0;height:3px;
    background:var(--grad);transform:scaleX(0);transform-origin:left;transition:transform .5s cubic-bezier(.2,.65,.25,1);
  }
  .svc:hover::before{transform:scaleX(1)}
  .svc-ico{
    width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;
    background:linear-gradient(135deg,rgba(23,108,158,.1),rgba(27,150,120,.1));
    margin-bottom:22px;transition:transform .45s;
  }
  .svc:hover .svc-ico{transform:scale(1.08) rotate(-4deg)}
  .svc-ico svg{width:24px;height:24px;stroke:url(#icoGrad);stroke-width:1.8;fill:none;stroke-linecap:round;stroke-linejoin:round}
  .svc h3{font-size:19px;font-weight:600;margin-bottom:10px;letter-spacing:-.01em}
  .svc p{font-size:14.5px;color:var(--muted)}
  .svc .num{
    position:absolute;top:26px;right:28px;font-family:var(--serif);font-size:15px;
    color:#c3cbda;letter-spacing:.1em;
  }

  /* ---------- results band ---------- */
  .results{background:var(--ink);color:#fff;position:relative;overflow:hidden}
  .results .blob.b1{background:#274a86;opacity:.55}
  .results .blob.b2{background:#1e6553;opacity:.5}
  .results h2{color:#fff}
  .results .section-head p{color:#9fb0cc}
  .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:10px}
  @media(max-width:900px){.stats{grid-template-columns:repeat(2,1fr)}}
  .stat{
    border:1px solid rgba(255,255,255,.1);border-radius:var(--radius);padding:34px 28px;
    background:rgba(255,255,255,.03);transition:background .4s,transform .4s;
  }
  .stat:hover{background:rgba(255,255,255,.07);transform:translateY(-5px)}
  .stat .n{font-family:var(--serif);font-size:clamp(40px,4.5vw,58px);line-height:1;
    background:linear-gradient(100deg,#4b96bc,#55ad98 55%,#68b88e);
    -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .stat .l{margin-top:12px;font-size:13.5px;color:#9fb0cc}
  .results-note{margin-top:34px;font-size:12.5px;color:#71809c}
  .report-label{font-size:11px;font-weight:600;letter-spacing:.28em;text-transform:uppercase;color:#8fa1c0;margin-bottom:22px}
  .measure-bg{position:absolute;top:0;right:0;bottom:0;width:58%;overflow:hidden;pointer-events:none}
  .measure-bg video{
    width:100%;height:100%;object-fit:cover;opacity:.55;mix-blend-mode:screen;
    filter:hue-rotate(-90deg) saturate(.95);
    mask-image:linear-gradient(90deg,transparent 0%,#000 48%);
    -webkit-mask-image:linear-gradient(90deg,transparent 0%,#000 48%);
  }
  @media(max-width:860px){.measure-bg{display:none}}
  .scarcity{
    margin-top:32px;max-width:600px;padding:18px 24px;background:var(--surface);
    border:1px solid var(--line);border-radius:16px;font-size:14.5px;color:var(--ink-soft);
    display:flex;gap:12px;align-items:flex-start;
  }
  .scarcity::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--grad);flex-shrink:0;margin-top:7px}

  /* ---------- comparison table ---------- */
  .cmp-scroll{overflow-x:auto;padding-bottom:8px}
  .cmp{
    min-width:840px;display:grid;grid-template-columns:1.25fr 1.05fr 1fr 1fr;
    border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;background:var(--surface);
  }
  .cmp > div{padding:17px 22px;font-size:13.5px;color:var(--muted);border-top:1px solid var(--line);display:flex;align-items:center;line-height:1.45}
  .cmp > .head{border-top:none;padding-top:22px;padding-bottom:22px;font-weight:600;color:var(--ink);font-size:14.5px}
  .cmp .crit{font-weight:600;color:var(--ink);font-size:13px;letter-spacing:.02em}
  .cmp .avia{
    background:linear-gradient(180deg,rgba(22,133,111,.07),rgba(23,108,158,.04));
    color:var(--ink-soft);font-weight:500;position:relative;
  }
  .cmp > .head.avia{overflow:hidden}
  .cmp > .head.avia::before{content:"";position:absolute;top:0;left:0;right:0;height:3px;background:var(--grad)}
  .cmp .head.avia .wordmark{font-size:17px;letter-spacing:.3em}

  /* ---------- FAQ ---------- */
  .faq{max-width:820px}
  .faq-item{border:1px solid var(--line);border-radius:16px;background:var(--surface);margin-bottom:12px;transition:box-shadow .35s,border-color .35s}
  .faq-item.open{box-shadow:0 20px 44px -26px rgba(46,68,120,.35);border-color:rgba(22,133,111,.3)}
  .faq-q{
    width:100%;display:flex;justify-content:space-between;align-items:center;gap:16px;
    padding:19px 24px;background:none;border:none;cursor:pointer;font:inherit;
    font-size:15.5px;font-weight:600;color:var(--ink);text-align:left;
  }
  .faq-q .plus{
    width:26px;height:26px;border-radius:50%;border:1px solid rgba(16,26,46,.18);flex-shrink:0;
    display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:500;color:var(--violet);
    transition:transform .4s cubic-bezier(.2,.65,.25,1),background .3s,color .3s;
  }
  .faq-item.open .plus{transform:rotate(45deg);background:var(--violet);color:#fff;border-color:transparent}
  .faq-a{display:grid;grid-template-rows:0fr;transition:grid-template-rows .5s cubic-bezier(.2,.65,.25,1)}
  .faq-item.open .faq-a{grid-template-rows:1fr}
  .faq-a > div{overflow:hidden}
  .faq-a p{padding:0 24px 20px;font-size:14.5px;color:var(--muted)}
  .founding-sub{margin-top:24px;color:var(--muted);font-size:16.5px;max-width:580px;margin-left:auto;margin-right:auto}
  .risk{margin-top:24px;font-size:13px;color:#9fb0cc;max-width:470px;margin-left:auto;margin-right:auto;line-height:1.55}

  /* ---------- process ---------- */
  .steps{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;counter-reset:step}
  @media(max-width:960px){.steps{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:600px){.steps{grid-template-columns:1fr}}
  .step{position:relative;padding:30px 26px 30px;border-radius:var(--radius);background:var(--surface);border:1px solid var(--line);transition:transform .45s,box-shadow .45s}
  .step:hover{transform:translateY(-6px);box-shadow:0 26px 55px -30px rgba(46,68,120,.3)}
  .step .badge{
    width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;
    font-family:var(--serif);font-size:19px;color:#fff;background:var(--grad);margin-bottom:20px;
    box-shadow:0 10px 22px -8px rgba(22,133,111,.55);
  }
  .step h3{font-size:17px;font-weight:600;margin-bottom:8px}
  .step p{font-size:14px;color:var(--muted)}

  /* ---------- sectors ---------- */
  .sectors{display:flex;flex-wrap:wrap;gap:14px}
  .sector{
    padding:13px 24px;border-radius:999px;border:1px solid var(--line);background:var(--surface);
    font-size:14px;font-weight:500;color:var(--ink-soft);
    transition:all .35s cubic-bezier(.2,.65,.25,1);cursor:default;
  }
  .sector:hover{
    border-color:transparent;color:#fff;background:var(--grad);
    transform:translateY(-3px);box-shadow:0 14px 28px -12px rgba(22,133,111,.5);
  }

  /* ---------- quote ---------- */
  .quote{max-width:820px;margin:0 auto;text-align:center}
  .quote blockquote{font-family:var(--serif);font-size:clamp(26px,3.4vw,40px);line-height:1.3;color:var(--ink);font-style:italic}
  .quote cite{display:block;margin-top:26px;font-style:normal;font-size:14px;color:var(--muted)}
  .quote cite b{color:var(--ink);font-weight:600;display:block;font-size:15px}
  .quote .stars{color:var(--violet);letter-spacing:6px;margin-bottom:22px;font-size:15px}

  /* ---------- CTA ---------- */
  .cta-card{
    position:relative;border-radius:34px;overflow:hidden;padding:90px 40px;text-align:center;
    background:var(--ink);color:#fff;isolation:isolate;
  }
  .cta-card::before{
    content:"";position:absolute;inset:-40%;z-index:-1;
    background:conic-gradient(from 0deg,#176c9e,#16856f,#1b9678,#176c9e);
    filter:blur(120px);opacity:.55;animation:spin 14s linear infinite;
  }
  @keyframes spin{to{transform:rotate(1turn)}}
  .cta-card h2{color:#fff;max-width:640px;margin:0 auto}
  .cta-card p{color:#c9d4e8;margin:20px auto 36px;max-width:460px}
  .cta-card .btn{background:#fff;color:var(--ink)!important}
  .cta-card .btn:hover{color:#fff!important}
  .cta-email{margin-top:26px;font-size:14px;color:#9fb0cc}
  .cta-email a{color:#fff;text-decoration:none;border-bottom:1px solid rgba(255,255,255,.35)}

  /* ---------- footer ---------- */
  footer{padding:54px 0 40px;border-top:1px solid var(--line)}
  .foot{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}
  .foot small{color:var(--muted);font-size:13px}
  .foot .logo img{width:34px;height:34px}
  .foot .wordmark{font-size:20px}

  /* ---------- motion-stack (GSAP mode) additions ---------- */
  .progress{position:fixed;top:0;left:0;right:0;height:3px;z-index:60;pointer-events:none}
  .progress i{display:block;height:100%;background:var(--grad);transform:scaleX(0);transform-origin:left}
  .hero h1 .word{display:inline-block;white-space:nowrap}
  .hero h1 .ch{display:inline-block;will-change:transform}
  .gsap-on .hero h1 .line span{animation:none;transform:none}
  .gsap-on .rv{transition:none}
  .gsap-on .btn{transition:box-shadow .3s}
  .cursor-dot{
    position:fixed;top:-160px;left:-160px;width:320px;height:320px;border-radius:50%;
    pointer-events:none;z-index:1;display:none;
    background:radial-gradient(circle,rgba(22,133,111,.16),rgba(23,108,158,.07) 45%,transparent 70%);
  }
  .gsap-on .cursor-dot{display:block}
  @media(pointer:coarse){.cursor-dot{display:none!important}}
  .track-line{height:2px;background:rgba(16,26,46,.07);border-radius:2px;margin-bottom:30px;overflow:hidden}
  .track-line i{display:block;height:100%;background:var(--grad);transform:scaleX(0);transform-origin:left}

  /* ---------- AI studio section ---------- */
  .ai-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:70px;align-items:center}
  @media(max-width:920px){.ai-grid{grid-template-columns:1fr;gap:80px}}
  .ai-card{
    position:relative;width:min(410px,88%);margin:0 auto;isolation:isolate;
  }
  .ai-card::before{
    content:"";position:absolute;inset:22px -22px -22px 22px;z-index:-1;
    border:1px solid rgba(22,133,111,.2);
    border-radius:48% 48% 34px 34px / 15% 15% 34px 34px;
    background:linear-gradient(145deg,rgba(23,108,158,.09),rgba(27,150,120,.14));
  }
  .ai-card img,.ai-card video{
    width:100%;aspect-ratio:4/5;object-fit:cover;object-position:center;
    border-radius:48% 48% 34px 34px / 15% 15% 34px 34px;display:block;
    background:linear-gradient(145deg,#d6e3ea,#d7e7e1 55%,#e5ece9);
    box-shadow:0 45px 90px -35px rgba(46,68,120,.45);
  }
  @media(max-width:520px){
    .ai-card{width:min(340px,86%)}
    .ai-card::before{inset:14px -14px -14px 14px}
  }
  .snd-btn{
    position:absolute;bottom:18px;left:18px;width:46px;height:46px;border-radius:50%;
    border:1px solid rgba(255,255,255,.5);background:rgba(16,26,46,.55);color:#fff;cursor:pointer;
    display:flex;align-items:center;justify-content:center;backdrop-filter:blur(8px);
    transition:transform .3s,background .3s;z-index:2;
  }
  .snd-btn:hover{transform:scale(1.1);background:rgba(16,26,46,.75)}
  .snd-btn svg{width:20px;height:20px}
  .ai-bubble{
    position:absolute;background:#fff;border:1px solid var(--line);border-radius:16px;
    padding:12px 16px;font-size:13px;font-weight:500;color:var(--ink-soft);
    box-shadow:0 16px 36px -14px rgba(46,68,120,.4);max-width:230px;line-height:1.4;
  }
  .ab1{top:10%;left:-9%;border-bottom-left-radius:5px;animation:floaty 7s ease-in-out infinite .4s}
  .ab2{bottom:8%;right:-7%;background:var(--grad);color:#fff;border:none;border-bottom-right-radius:5px;animation:floaty 8s ease-in-out infinite 1s}
  .ai-live{
    position:absolute;top:-15px;right:20px;background:#fff;border:1px solid var(--line);
    border-radius:999px;padding:8px 16px;font-size:12px;font-weight:600;color:var(--ink);
    display:flex;align-items:center;gap:8px;box-shadow:0 12px 26px -12px rgba(46,68,120,.4);
  }
  .live-dot{width:8px;height:8px;border-radius:50%;background:#2fca70;box-shadow:0 0 0 0 rgba(47,202,112,.5);animation:liveDot 1.8s infinite}
  @keyframes liveDot{70%{box-shadow:0 0 0 9px rgba(47,202,112,0)}100%{box-shadow:0 0 0 0 rgba(47,202,112,0)}}
  .ai-lead{margin-top:18px;color:var(--muted);font-size:17px}
  .ai-feats{list-style:none;margin:30px 0 36px;display:grid;gap:16px}
  .ai-feats li{display:flex;gap:14px;align-items:flex-start;font-size:14.5px;color:var(--muted)}
  .ai-feats li b{display:block;color:var(--ink);font-size:15px;font-weight:600}
  .fi{
    width:40px;height:40px;border-radius:12px;flex-shrink:0;display:flex;align-items:center;justify-content:center;
    background:linear-gradient(135deg,rgba(23,108,158,.1),rgba(27,150,120,.1));
  }
  .fi svg{width:20px;height:20px;stroke:url(#icoGrad);stroke-width:1.8;fill:none;stroke-linecap:round;stroke-linejoin:round}

  /* ---------- chat widget ---------- */
  .chat-fab{
    position:fixed;right:22px;bottom:22px;z-index:70;width:62px;height:62px;border-radius:50%;
    cursor:pointer;border:none;padding:0;background:none;
  }
  .chat-fab::before{content:"";position:absolute;inset:-3px;border-radius:50%;background:var(--grad);animation:fabPulse 2.6s infinite}
  @keyframes fabPulse{0%{transform:scale(1);opacity:.55}70%,100%{transform:scale(1.45);opacity:0}}
  .chat-fab img{position:relative;width:100%;height:100%;border-radius:50%;object-fit:cover;border:3px solid #fff;box-shadow:0 12px 30px -8px rgba(16,26,46,.45);display:block}
  .chat-fab .online{position:absolute;bottom:3px;right:3px;width:14px;height:14px;border-radius:50%;background:#2fca70;border:2.5px solid #fff}
  .chat-teaser{
    position:fixed;right:96px;bottom:32px;z-index:70;background:#fff;border:1px solid var(--line);
    border-radius:16px;border-bottom-right-radius:5px;padding:12px 16px;font-size:13px;font-weight:500;
    color:var(--ink-soft);box-shadow:0 18px 40px -14px rgba(16,26,46,.35);max-width:230px;
    opacity:0;transform:translateY(12px);transition:.5s cubic-bezier(.2,.65,.25,1);pointer-events:none;
  }
  .chat-teaser.show{opacity:1;transform:none;pointer-events:auto;cursor:pointer}
  .chat-panel{
    position:fixed;right:22px;bottom:96px;z-index:71;width:min(360px,calc(100vw - 44px));
    height:min(500px,calc(100dvh - 130px));background:#fff;border-radius:22px;overflow:hidden;
    display:flex;flex-direction:column;box-shadow:0 35px 90px -20px rgba(16,26,46,.45);
    opacity:0;transform:translateY(26px) scale(.95);transform-origin:bottom right;
    transition:.45s cubic-bezier(.2,.65,.25,1);pointer-events:none;
  }
  .chat-panel.open{opacity:1;transform:none;pointer-events:auto}
  .chat-head{display:flex;align-items:center;gap:12px;padding:14px 16px;background:var(--ink);color:#fff}
  .chat-head img{width:40px;height:40px;border-radius:50%;object-fit:cover;border:2px solid rgba(255,255,255,.35)}
  .chat-head .who b{display:block;font-size:14.5px;font-weight:600}
  .chat-head .who span{font-size:11.5px;color:#9fb0cc;display:flex;align-items:center;gap:6px}
  .chat-head .who .live-dot{width:6px;height:6px}
  .chat-close{margin-left:auto;background:none;border:none;color:#9fb0cc;font-size:22px;cursor:pointer;line-height:1;padding:4px}
  .chat-close:hover{color:#fff}
  .chat-msgs{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:10px;background:#f5f7fc}
  .msg{max-width:82%;padding:10px 14px;border-radius:16px;font-size:13.5px;line-height:1.45;animation:msgIn .4s cubic-bezier(.2,.65,.25,1)}
  .msg.bot{background:#fff;border:1px solid var(--line);border-bottom-left-radius:5px;align-self:flex-start;color:var(--ink-soft)}
  .msg.user{background:var(--grad);color:#fff;border-bottom-right-radius:5px;align-self:flex-end}
  @keyframes msgIn{from{opacity:0;transform:translateY(10px) scale(.97)}}
  .typing{align-self:flex-start;background:#fff;border:1px solid var(--line);border-radius:16px;border-bottom-left-radius:5px;padding:13px 15px;display:inline-flex;gap:5px}
  .typing i{width:6px;height:6px;border-radius:50%;background:#a5b1c5;animation:tBlink 1.2s infinite}
  .typing i:nth-child(2){animation-delay:.18s}.typing i:nth-child(3){animation-delay:.36s}
  @keyframes tBlink{0%,60%,100%{opacity:.3;transform:translateY(0)}30%{opacity:1;transform:translateY(-3px)}}
  .chips{display:flex;flex-wrap:wrap;gap:8px;padding:4px 16px 12px;background:#f5f7fc}
  .chip{border:1px solid rgba(22,133,111,.4);color:var(--violet);background:#fff;border-radius:999px;padding:7px 13px;font-size:12px;font-weight:600;cursor:pointer;transition:.25s;font-family:inherit}
  .chip:hover{background:var(--violet);color:#fff;border-color:transparent}
  .chat-input{display:flex;gap:10px;padding:12px;border-top:1px solid var(--line);background:#fff}
  .chat-input input{flex:1;border:none;outline:none;font:inherit;font-size:13.5px;padding:10px 14px;background:#f2f5fa;border-radius:12px;color:var(--ink)}
  .chat-send{width:40px;height:40px;border-radius:50%;border:none;background:var(--grad);color:#fff;cursor:pointer;font-size:15px;display:flex;align-items:center;justify-content:center;transition:transform .25s}
  .chat-send:hover{transform:scale(1.08)}
  .chat-note{text-align:center;font-size:10.5px;color:#9aa6bb;padding:0 12px 10px;background:#fff}
  @media(max-width:520px){
    .chat-fab{right:14px;bottom:14px;width:56px;height:56px}
    .chat-teaser{right:80px;bottom:22px;max-width:calc(100vw - 104px)}
    .chat-panel{right:10px;bottom:80px;width:calc(100vw - 20px);height:min(500px,calc(100dvh - 94px))}
  }

  /* ============ SHOWPIECE (light) ============ */
  h2{font-size:clamp(38px,5vw,64px)}
  .hero h1{font-size:clamp(48px,7vw,100px)}
  .mono{font-family:ui-monospace,'SF Mono',Menlo,Consolas,monospace;font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;color:#8a93a8}
  .vitals{position:absolute;top:16px;left:18px;z-index:2;display:flex;align-items:center;gap:8px}
  .vitals .rec{width:7px;height:7px;border-radius:50%;background:#ff5470;animation:blinkRec 1.4s steps(2) infinite}
  @keyframes blinkRec{50%{opacity:.15}}
  .hero-tape{margin-top:30px;display:flex;align-items:center;gap:10px;opacity:0;animation:fadeUp 1s ease 1.15s forwards}
  .hero-tape .rec{width:7px;height:7px;border-radius:50%;background:#2fca70;animation:blinkRec 1.8s steps(2) infinite}
  .section-head{position:relative;z-index:0}
  .sec-num{
    position:absolute;right:0;top:-18px;z-index:-1;pointer-events:none;user-select:none;
    font-family:var(--serif);font-size:clamp(70px,9vw,130px);line-height:1;
    color:transparent;-webkit-text-stroke:1px rgba(16,26,46,.14);
  }
  @media(max-width:720px){.sec-num{display:none}}
  .foot-mark{
    font-family:var(--serif);font-size:clamp(90px,17vw,230px);line-height:.9;letter-spacing:.14em;
    text-align:center;color:transparent;-webkit-text-stroke:1px rgba(16,26,46,.12);
    user-select:none;pointer-events:none;margin:60px 0 -10px;
  }

  /* ---------- work strip ---------- */
  .work-band{padding:100px 0 90px;overflow:hidden}
  .work-head{max-width:1180px;margin:0 auto 44px;padding:0 28px;display:flex;justify-content:space-between;align-items:end;gap:20px;flex-wrap:wrap}
  .work-strip{display:flex;overflow:hidden;mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);-webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent)}
  .work-track{display:flex;gap:22px;padding-right:22px;width:max-content;flex-shrink:0;animation:scrollX 44s linear infinite}
  .work-strip:hover .work-track{animation-play-state:paused}
  .work-card{
    width:290px;flex-shrink:0;border-radius:20px;border:1px solid var(--line);background:var(--surface);
    overflow:hidden;transition:transform .4s cubic-bezier(.2,.65,.25,1),box-shadow .4s;
  }
  .work-card:hover{transform:translateY(-8px) scale(1.02);box-shadow:0 30px 60px -28px rgba(46,68,120,.35)}
  .work-thumb{height:168px;position:relative;display:flex;align-items:center;justify-content:center}
  .work-thumb .big{font-family:var(--serif);font-size:44px;color:rgba(255,255,255,.9);font-style:italic}
  .work-thumb .plat{position:absolute;top:12px;left:14px;color:rgba(255,255,255,.85)}
  .work-thumb .fmt{position:absolute;bottom:12px;right:14px;color:rgba(255,255,255,.75)}
  .work-body{padding:15px 18px 17px}
  .work-body b{display:block;font-size:14px;color:var(--ink);margin-bottom:4px}
  .work-body span{font-size:12.5px;color:var(--muted)}

  /* ---------- pinned process ---------- */
  .gsap-on .steps.pinned{display:flex;flex-wrap:nowrap;width:max-content;gap:26px}
  .gsap-on .steps.pinned .step{width:min(420px,72vw)}
  #process.pin-active{overflow:hidden}

